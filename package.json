{
  "name": "obsidian-pdf-digital-signature",
  "version": "1.0.0",
  "description": "Zero-dependency digital cryptographic signature (PAdES/PKCS#7) and custom footer stamping for exported PDFs in Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "pdf",
    "digital-signature",
    "cryptography",
    "pades",
    "pfx",
    "pkcs12"
  ],
  "author": "Benjamín Alcalde G.",
  "license": "MIT",
  "dependencies": {
    "@signpdf/placeholder-pdf-lib": "^3.3.0",
    "@signpdf/placeholder-plain": "^3.2.3",
    "@signpdf/signer-p12": "^3.2.3",
    "@signpdf/signpdf": "^3.2.3",
    "node-forge": "^1.3.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-forge": "^1.3.11",
    "esbuild": "0.25.0",
    "obsidian": "latest",
    "tslib": "^2.8.0",
    "typescript": "^5.7.0"
  }
}
